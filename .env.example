# Postgres (Neon). URL poolée pour l'app, URL directe pour les migrations.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# Authentification (better-auth).
# Secret : 32 octets aléatoires en base64 -> node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
# URL publique de l'app (http://127.0.0.1:3001 en local).
BETTER_AUTH_URL=""

# Ouvrir temporairement les inscriptions, uniquement pour scripts/seed-owner.ts.
# ALLOW_SIGNUP="1"
